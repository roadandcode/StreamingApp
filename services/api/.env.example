# Local development only. Copy to services/api/.env and replace the placeholder secrets
# (for example with `openssl rand -hex 32`). Never commit .env or reuse these values elsewhere.

NODE_ENV=development
# Deployment environment: development | test | staging | production (defaults to NODE_ENV).
# With NODE_ENV=production only staging or production is accepted; fakes are refused in production.
# APP_ENV=development
PORT=3000
DATABASE_URL=postgres://streaming:streaming@localhost:5432/streaming_dev

# Required, at least 32 characters.
JWT_ACCESS_SECRET=replace-me-with-a-random-value-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed by CORS (admin dashboard, viewer website).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Viewer country: the trusted CDN header (only behind the CDN), otherwise the default.
DEFAULT_COUNTRY_CODE=IN
# TRUSTED_COUNTRY_HEADER=cloudfront-viewer-country

MAX_DEVICES=3
MAX_CONCURRENT_STREAMS=2
PLAYBACK_AUTH_TTL_SECONDS=300
PLAYBACK_HEARTBEAT_INTERVAL_SECONDS=30

# Base URL used to build the fake media upload/manifest URLs. Use your LAN address when testing on an
# emulator or a phone.
PUBLIC_API_BASE_URL=http://localhost:3000

# fake | aws (aws is a fail-closed stub until the real pipeline is configured)
MEDIA_PROVIDER=fake
FAKE_MEDIA_SIGNING_SECRET=replace-me-dev-media-signing-secret
FAKE_SAMPLE_MANIFEST_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# fake | live (live uses the Apple/Google verifiers, fail-closed stubs until configured)
BILLING_MODE=fake
FAKE_WEBHOOK_SECRET=replace-me-dev-webhook-secret

# Razorpay web checkout (use test-mode keys locally). Leave unset to keep the checkout and
# /v1/webhooks/razorpay endpoints disabled (503 PROVIDER_NOT_CONFIGURED).
# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=replace-me
# RAZORPAY_WEBHOOK_SECRET=replace-me
# Razorpay plan_ids the seed maps to premium_monthly / premium_yearly.
# RAZORPAY_PLAN_ID_MONTHLY=plan_replace_me
# RAZORPAY_PLAN_ID_YEARLY=plan_replace_me

# Rate limits (requests per window) for the auth and playback routes.
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_PLAYBACK_LIMIT=60
THROTTLE_PLAYBACK_TTL_SECONDS=60

# Used by `pnpm db:seed` only.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-admin-password
