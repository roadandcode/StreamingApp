<?xml version="1.0" encoding="utf-8"?>
<!-- Release and profile builds: HTTPS only, system certificate authorities only.
     The debug build replaces this file (src/debug/res/xml) to reach the local API. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
