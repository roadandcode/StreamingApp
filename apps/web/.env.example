# Viewer website (apps/web). Copy to .env.local for development; never commit real values.

# Base URL of the API, as seen from this web server (server-to-server).
API_BASE_URL=http://localhost:3000

# Key for the encrypted session cookie: at least 32 random characters, different from the admin
# dashboard's value. Generate one with: openssl rand -hex 32
SESSION_COOKIE_SECRET=

# Show the development "Simulate purchase (dev)" button (the API must run with BILLING_MODE=fake).
NEXT_PUBLIC_FAKE_BILLING=false

# Refuse playback authorizations without DRM (drm: null). Turn on in production once DRM is live.
REQUIRE_DRM=false

# Highest rendition the web player selects. The real cap must also be enforced in packaging and in
# the DRM licence policy.
WEB_MAX_VIDEO_HEIGHT=720

# Public origin of this website: canonical URLs, sitemap and request origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Comma-separated origins the browser may load media from (manifests, segments, DRM licences,
# thumbnails). Used by the Content-Security-Policy. Defaults to the origin of API_BASE_URL, which
# serves the fake media URLs in development; add the origin of the API's FAKE_SAMPLE_MANIFEST_URL
# test stream, and in production the CDN and DRM licence server origins.
MEDIA_ORIGINS=http://localhost:3000

# Optional: name of the CDN-set viewer-country header to forward to the API (e.g.
# cloudfront-viewer-country). Leave empty when the site is not behind such a CDN.
TRUSTED_COUNTRY_HEADER=
