# Admin dashboard configuration. Copy to .env.local for local development.
# Values here are placeholders; never commit real secrets.

# Base URL of the StreamingApp API (without the /v1 suffix).
API_BASE_URL=http://localhost:3000

# Key used to encrypt the admin session cookie. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-characters

# End-to-end tests (pnpm test:e2e). The API at API_BASE_URL must have these accounts.
# `pnpm test:e2e:mock` instead starts e2e/mock-api.mjs and the built app itself, with defaults.
# E2E_BASE_URL=http://localhost:3001
# E2E_ADMIN_EMAIL=admin@example.test
# E2E_ADMIN_PASSWORD=
# E2E_VIEWER_EMAIL=viewer@example.test
# E2E_VIEWER_PASSWORD=
